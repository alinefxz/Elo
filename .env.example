# RESUMO DO ARQUIVO
# =================
# Este e apenas um MODELO de configuracao para novos computadores.
#
# A pessoa deve duplicar este arquivo com o nome .env e substituir os valores.
# O .env real e ignorado pelo Git e nunca deve ser enviado ao GitHub.

# Chave usada pelo Django para assinar sessoes, mensagens e tokens.
# Gere uma nova em cada ambiente com:
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=gere_uma_chave_secreta

# True mostra erros detalhados durante o desenvolvimento.
# Em producao, o valor precisa ser False.
DJANGO_DEBUG=True

# Nome do banco criado no pgAdmin.
DB_NAME=elo_db

# Login/Group Role do PostgreSQL usado pela aplicacao.
DB_USER=elo_user

# Cada pessoa coloca aqui a senha que criou no PostgreSQL local.
# Nunca escrever a senha real neste arquivo de exemplo.
DB_PASSWORD=adicione_a_senha_local

# 127.0.0.1 indica que o PostgreSQL esta no mesmo computador.
DB_HOST=127.0.0.1

# Porta padrao do PostgreSQL.
DB_PORT=5432
